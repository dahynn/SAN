APP_ENV=local
LOG_LEVEL=INFO
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_USE_RESPONSES_API=false
TIL_SUMMARY_MAX_CONCURRENCY=4
TIL_REDUCE_MAX_CONCURRENCY=2
TIL_CACHE_ENABLED=true
TIL_SUMMARY_CACHE_TTL_SECONDS=1800
TIL_RESULT_CACHE_TTL_SECONDS=1800
TIL_DIRECT_REDUCE_MAX_CHARS=12000
AI_AUDIT_DB_PATH=/tmp/san-ai-execution-audit.sqlite3
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT=30
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VECTORSTORE_URL=http://localhost:6333
TAVILY_API_KEY=your-tavily-api-key
