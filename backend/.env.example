# PostgreSQL Configuration
DB_PASSWORD=db_password

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=grafana_admin_password
GRAFANA_DB_PASSWORD=grafana_reader_password

# JWT secret
JWT_SECRET=jwt_secret_key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth Login Policy
AUTH_LOGIN_MAX_FAIL_COUNT=5
AUTH_LOGIN_FAIL_WINDOW_SECONDS=300
AUTH_LOGIN_LOCK_DURATION_SECONDS=900

# GitHub OAuth
GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback
GITHUB_SCOPE=read:user,repo
GITHUB_SUCCESS_REDIRECT_URI=http://localhost:5173/auth/github/success
GITHUB_FAILURE_REDIRECT_URI=http://localhost:5173/auth/github/failure
GITHUB_TOKEN_ENCRYPTION_SECRET=base64_encoded_32_byte_secret

# AWS S3
AWS_S3_BUCKET=s3_bucket_name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=aws_access_key_id
AWS_SECRET_ACCESS_KEY=aws_secret_access_key
AWS_S3_PRESIGNED_URL_EXPIRATION_MINUTES=5
AWS_S3_MAX_FILE_SIZE_BYTES=10485760
AWS_S3_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
AWS_S3_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# FEEDBACK_MM
FEEDBACK_MM_WEBHOOK_URL=feedback_mm_webhook_url
FEEDBACK_MM_MAX_ATTEMPTS=3
