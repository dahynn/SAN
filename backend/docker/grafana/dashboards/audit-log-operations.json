          "rawSql": "SELECT\n  (date_trunc('minute', occurred_at) AT TIME ZONE 'Asia/Seoul') AS time,\n  COUNT(*) FILTER (WHERE outcome = 'SUCCESS') AS success_count,\n  COUNT(*) FILTER (WHERE outcome = 'FAILURE') AS failure_count\nFROM audit_log_events\nWHERE occurred_at BETWEEN ($__timeFrom()::timestamptz AT TIME ZONE 'Asia/Seoul') AND ($__timeTo()::timestamptz AT TIME ZONE 'Asia/Seoul')\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
